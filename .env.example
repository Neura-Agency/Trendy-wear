# Environment Variables for Trendy Wear

# Set these in your Vercel dashboard for production deployment
# Dashboard: https://vercel.com/your-team/trendy-wear/settings/environment-variables

### Admin Passwords
YAHYA_PASSWORD=secure_yahya_password_here
BILAL_PASSWORD=secure_bilal_password_here

### Store Passwords  
TRENDY_PASSWORD=secure_trendy_password_here
GRENZ_PASSWORD=secure_grenz_password_here
THRIFT_PASSWORD=secure_thrift_password_here
PRELOVED_PASSWORD=secure_preloved_password_here

### Optional: Database URL for future upgrade
# DATABASE_URL=your_database_connection_string_here